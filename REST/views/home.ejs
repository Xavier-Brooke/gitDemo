<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style/home.css">
    <title>home</title>
</head>
<body>
    <% for(let user of users) {%>
        <div class="user-div">
            <div class="user-info-div">
                <p class="user-info-name"><%= user.name %></p>
                <p class="user-info-msg"><%= user.msg %></p>
            </div>
            <div class="user-functionalities">
                <form action="/api/<%= user.id %>/details" method="get" style="display: inline-block;"><button>Details</button></form>
                <form style="display: inline-block;"><button>Edit</button></form>
                <form style="display: inline-block;"><button>Delete</button></form>
            </div>
        </div>
    <% } %>
</body>
</html>