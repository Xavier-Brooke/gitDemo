<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>newChat</title>
</head>
<body>
    <h1>
        Create New Chat
    </h1>
    <form method="post" action="/api">
        <label for="name">Enter Your Name :- </label>
        <input type="text" id="name" name="name" placeholder="Enter your name here!">
        <br><br>
        <textarea name="msg" placeholder="Enter your msg here!" rows="5" cols="20"></textarea>
        <br><br>
        <button type="reset">Reset</button> &emsp; <button type="submit">Submit</button>
    </form>
</body>
</html>