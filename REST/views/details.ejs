<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>details</title>
</head>
<body>
    <h2>User Details</h2>
    <div class="details">
        <h4>Id :- <%= user.id %></h4>
        <p>Name :- <%= user.name %></p>
        <p>MSG :- <%= user.msg %></p>
        <p>Time :- <%= user.sent_at %></p>
    </div>
</body>
</html>